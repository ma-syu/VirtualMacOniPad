.DS_Store
.env
.venv/
__pycache__/
build/
artifacts/
DerivedData/
DeviceDiagnostics/

# Apple restore/runtime artifacts and VM state never belong in Git.
*.ipsw
*.deb
*.dmg
*.img
*.raw
*.qcow2
*.utm
*.xip
VM.bundle/

# Generated Apple binaries, signatures, diagnostics, and local manifests.
payload/
logs/
DeviceCrashLogs/
*.dSYM/
*.ips

# ローカルのツール設定と作業記録。
#
# WHY ここに書くか:
#   これらはマシン固有で、リポジトリの成果物ではない。
#   開発環境のグローバル設定 (~/.config/git/ignore) でも除外しているが、
#   そちらはこのマシンにしか存在しない。別のマシンや CI でクローンした時点で
#   除外が効かなくなるため、リポジトリと一緒に移動するこの層でも宣言する。
.claude/
.harness/
